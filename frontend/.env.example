# Laravel backend as seen from the Next.js server (BFF proxy and SSR). In docker-compose: http://nginx
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ТЕТА
# Reverb (websockets): same values as REVERB_APP_KEY / host / port of the backend
NEXT_PUBLIC_REVERB_KEY=teta-local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
